# Copy to .env and fill in. Never commit the real .env.

# Admin login for /admin. These ARE the credentials — there is no user table
# involved. To change them, edit these values (in Vercel, then redeploy) and
# any existing admin session is invalidated.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Signs the admin session cookie. REQUIRED in production — the server refuses
# to start without it. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Neon Postgres connection string. Stores portfolio content (projects, skills,
# certificates, internships, profile) and the session table in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini key, used by the admin panel's resume analysis and
# content-optimization routes.
GEMINI_API_KEY=
